# Normalize line endings for text source files
* text=auto eol=lf

*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Binary assets keep their bytes untouched
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.ico  binary
*.pdf  binary
*.docx binary
