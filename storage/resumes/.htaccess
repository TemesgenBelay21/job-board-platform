# Resume files are private user documents. They must only ever be served
# through the download controllers, which check permissions first.
# This file is a second line of defence in case the storage folder is ever
# exposed by a web server misconfiguration.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
